{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Docusaurus Dev (pnpm)",
        "runtimeExecutable": "pnpm",
        "runtimeArgs": ["start"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Docusaurus Build (pnpm)",
        "runtimeExecutable": "pnpm",
        "runtimeArgs": ["build"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Docusaurus Serve (pnpm)",
        "runtimeExecutable": "pnpm",
        "runtimeArgs": ["serve"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      }
    ]
  }
  